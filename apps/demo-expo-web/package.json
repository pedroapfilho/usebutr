{
  "name": "demo-expo-web",
  "version": "0.0.13",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "BROWSER=none portless run --name usebutr.demo-expo-web expo start --web",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .expo node_modules dist"
  },
  "dependencies": {
    "@expo/metro-runtime": "^57.0.16",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@usebutr/core": "workspace:*",
    "@usebutr/react": "workspace:*",
    "@usebutr/wallets": "workspace:*",
    "expo": "^57.0.25",
    "expo-constants": "^57.0.19",
    "expo-image": "^57.0.5",
    "expo-linking": "^57.0.11",
    "expo-router": "^57.0.23",
    "expo-status-bar": "^57.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-native": "^0.86.3",
    "react-native-safe-area-context": "^5.10.0",
    "react-native-screens": "^4.28.0",
    "react-native-web": "^0.21.2",
    "uniwind": "1.12.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@repo/typescript-config": "workspace:*",
    "@types/react": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
