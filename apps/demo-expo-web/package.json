{
  "name": "demo-expo-web",
  "version": "0.0.13",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "BROWSER=none portless run --name usebutr.demo-expo-web expo start --web",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .expo node_modules dist"
  },
  "dependencies": {
    "@expo/metro-runtime": "^58.0.17",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@usebutr/core": "workspace:*",
    "@usebutr/react": "workspace:*",
    "@usebutr/wallets": "workspace:*",
    "expo": "^58.0.23",
    "expo-constants": "^58.0.15",
    "expo-image": "^58.0.18",
    "expo-linking": "^58.0.16",
    "expo-router": "^58.0.30",
    "expo-status-bar": "^58.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-native": "^0.88.1",
    "react-native-reanimated": "^4.7.1",
    "react-native-safe-area-context": "^5.11.1",
    "react-native-screens": "^4.30.1",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "^0.13.0",
    "uniwind": "1.13.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@repo/typescript-config": "workspace:*",
    "@types/react": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
