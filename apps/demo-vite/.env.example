# WalletConnect Cloud project id (https://cloud.reown.com).
# Copy to .env.local; without it the demo skips the WalletConnect connector.
VITE_WC_PROJECT_ID=YOUR_WALLETCONNECT_PROJECT_ID_HERE

# Base URL of the docs site, used by the demo nav links.
# Optional; when unset it falls back to https://docs.usebutr.com.
# VITE_DOCS_URL=

# Base URL of the landing site, used by the demo nav links.
# Optional; when unset it falls back to https://usebutr.com.
# VITE_WEB_URL=
