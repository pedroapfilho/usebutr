{
  "name": "usebutr-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "turbo run start",
    "dev": "node scripts/dev.mjs",
    "lint": "oxlint .",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "turbo run typecheck",
    "build": "turbo run build",
    "clean": "turbo run clean && rm -rf node_modules",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish",
    "fallow": "fallow",
    "fallow:dead": "fallow dead-code",
    "fallow:dupes": "fallow dupes",
    "fallow:health": "fallow health --score",
    "fallow:audit": "fallow audit",
    "prepare": "husky",
    "check:shadcn": "node scripts/check-shadcn.mjs"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@playwright/test": "^1.65.0",
    "@shadcn/lint": "0.2.5",
    "fallow": "^3.42.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.93.0",
    "oxlint-config-awesomeness": "^4.9.1",
    "oxlint-plugin-react-doctor": "^0.9.22",
    "oxlint-tsgolint": "^7.0.2006",
    "tsdown": "^0.23.7",
    "turbo": "^2.11.10",
    "zod-compiler": "^1.28.0"
  },
  "lint-staged": {
    "!(*.d).{ts,tsx,mts,cts,js,jsx,mjs,cjs}": [
      "oxlint"
    ],
    "*.{ts,tsx,mts,cts,js,jsx,mjs,cjs,json,md}": [
      "oxfmt"
    ]
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.13.1"
}
