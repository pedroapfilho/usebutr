{
  "name": "@usebutr/core",
  "version": "2.0.0",
  "description": "Core types, store, storage, and discovery seam for butr. No React, no protocols.",
  "keywords": [
    "butr",
    "dapp",
    "discovery",
    "react",
    "state-management",
    "typescript",
    "wallet",
    "web3",
    "zustand"
  ],
  "homepage": "https://docs.usebutr.com/api/core",
  "bugs": {
    "url": "https://github.com/pedroapfilho/usebutr/issues"
  },
  "license": "MIT",
  "author": "Pedro Filho <pedro@filho.me>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pedroapfilho/usebutr.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist",
    "dev": "tsdown --watch",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@repo/config-vitest": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "zustand": "^5.0.14"
  },
  "peerDependencies": {
    "zustand": ">=4.0.0"
  }
}
