{
  "name": "@usebutr/react",
  "version": "2.0.0",
  "description": "React provider and hooks for butr. Depends on @usebutr/core, react, zustand.",
  "keywords": [
    "butr",
    "dapp",
    "react",
    "react-hooks",
    "typescript",
    "wallet",
    "web3",
    "zustand"
  ],
  "homepage": "https://docs.usebutr.com/api/react",
  "bugs": {
    "url": "https://github.com/pedroapfilho/usebutr/issues"
  },
  "license": "MIT",
  "author": "Pedro Filho <pedro@filho.me>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pedroapfilho/usebutr.git",
    "directory": "packages/react"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist",
    "dev": "tsdown --watch",
    "prepack": "pnpm run build",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@usebutr/core": "workspace:*"
  },
  "devDependencies": {
    "@repo/config-vitest": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@usebutr/testing": "workspace:*",
    "jsdom": "^30.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0",
    "zustand": "^5.0.14"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "zustand": ">=4.5.0"
  }
}
