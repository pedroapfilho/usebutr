{
  "name": "@usebutr/wallets",
  "version": "2.0.0",
  "description": "Batteries-included EVM + SVM + Sui + Bitcoin + Polkadot discovery: autoDiscovery(), one WalletSource for every platform.",
  "keywords": [
    "bitcoin",
    "butr",
    "dapp",
    "ethereum",
    "polkadot",
    "solana",
    "sui",
    "typescript",
    "wallet",
    "wallet-standard",
    "web3"
  ],
  "homepage": "https://docs.usebutr.com/api/wallets",
  "bugs": {
    "url": "https://github.com/pedroapfilho/usebutr/issues"
  },
  "license": "MIT",
  "author": "Pedro Filho <pedro@filho.me>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pedroapfilho/usebutr.git",
    "directory": "packages/wallets"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist",
    "dev": "tsdown --watch",
    "prepack": "pnpm run build",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@usebutr/bitcoin": "workspace:*",
    "@usebutr/core": "workspace:*",
    "@usebutr/evm": "workspace:*",
    "@usebutr/polkadot": "workspace:*",
    "@usebutr/sui": "workspace:*",
    "@usebutr/svm": "workspace:*",
    "@wallet-standard/app": "^1.1.0"
  },
  "devDependencies": {
    "@repo/config-vitest": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
